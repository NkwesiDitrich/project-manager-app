# Copy this file to .env and fill in your values. Do not commit .env.

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/tasco

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=your-long-random-secret-at-least-32-characters

# Frontend origin (for CORS and email links). In dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Port the server listens on (default 3001)
PORT=3001

# Optional: SendGrid for verification and password-reset emails
# SEND_GRID_API=SG.xxxxx
# FROM_EMAIL=noreply@yourdomain.com

# Optional: Arcjet for bot/rate limiting (app runs without it)
# ARCJET_KEY=ajkey_xxxxx
